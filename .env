# Bharath Enterprises Development Environment
# Set to real Firebase project credentials when connecting live Firebase services.
# When placeholder keys are detected, the app runs in resilient local persistent mock mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Configurable company WhatsApp number placeholder
VITE_COMPANY_WHATSAPP=919876543210

